        let badgeText = isSkipped ? (currentLang === 'EN' ? 'Skipped' : 'Đã bỏ qua') : (isFocused ? 'Focus 🔥' : `Unit ${unit.id}/6`);
        
        unitSec.innerHTML = `
          <div class="${headerCls}">
            <h3>${currentLang === 'EN' ? unit.titleEn : unit.titleVi}</h3>
            <p>${currentLang === 'EN' ? unit.descEn : unit.descVi}</p>
            <span class="unit-badge">${badgeText}</span>
          </div>
          <div class="path-container" id="path-unit-${unit.id}"></div>
        `;
        container.appendChild(unitSec);

        const pathContainer = unitSec.querySelector(`#path-unit-${unit.id}`);

        for(let lessonNum = 1; lessonNum <= 5; lessonNum++) {
          let rowDiv = document.createElement('div');
          rowDiv.className = 'node-row';

          let key = `${unit.id}-${lessonNum}`;
          let isCompleted = completedLessons[key] === true;
          
          let isCurrent = false;
          if(!isSkipped) {
            let foundActive = false;
            for(let u of UNITS_DATA) {
              if(skippedModes[u.id]) continue;
              for(let l = 1; l <= 5; l++) {
                if(!completedLessons[`${u.id}-${l}`]) {
                  if(u.id === unit.id && l === lessonNum) isCurrent = true;
                  foundActive = true;
                  break;
                }
              }
              if(foundActive) break;
            }
          }

          let nodeCls = 'path-node';
          if(lessonNum === 5) nodeCls += ' checkpoint';
          if(isCompleted) nodeCls += ' completed';
          else if(isCurrent) nodeCls += ' current';
          else if(isSkipped) nodeCls += ' locked';
          else {
            let prevKey = lessonNum === 1 ? `${unit.id-1}-5` : `${unit.id}-${lessonNum-1}`;
            if(!(unit.id === 1 && lessonNum === 1) && !completedLessons[prevKey]) {
              nodeCls += ' locked';
            }
          }

          let iconHtml = '<i class="fa-solid fa-lock"></i>';
          if(isCompleted) iconHtml = '<i class="fa-solid fa-check"></i>';
          else if(lessonNum === 5) {
            iconHtml = isCurrent ? '<i class="fa-solid fa-trophy" style="color:#fff;"></i>' : '<i class="fa-solid fa-trophy"></i>';
          } else {
            iconHtml = isCurrent ? '<i class="fa-solid fa-star" style="color:#fff;"></i>' : '<i class="fa-solid fa-book"></i>';
          }

          rowDiv.innerHTML = `
            <div class="${nodeCls}" onclick="startLesson(${unit.id}, ${lessonNum}, this)">
              ${iconHtml}
            </div>
          `;
          pathContainer.appendChild(rowDiv);
        }
      });
    }

    function openConfigModal() {
      const listDiv = document.getElementById('configUnitsList');
      listDiv.innerHTML = '';

      UNITS_DATA.forEach(unit => {
        let isFoc = focusModes[unit.id] ? 'checked' : '';
        let isSkp = skippedModes[unit.id] ? 'checked' : '';

        let row = document.createElement('div');
        row.className = 'config-row';
        row.innerHTML = `
          <div>
            <strong>Unit ${unit.id}: ${currentLang === 'EN' ? unit.titleEn.split(':')[1] : unit.titleVi.split(':')[1]}</strong>
          </div>
          <div style="display:flex; gap:16px;">
            <label style="font-size:0.85rem; cursor:pointer;"><input type="checkbox" id="focus_${unit.id}" ${isFoc}> Chuyên sâu</label>
            <label style="font-size:0.85rem; cursor:pointer;"><input type="checkbox" id="skip_${unit.id}" ${isSkp}> Bỏ qua</label>
          </div>
        `;
        listDiv.appendChild(row);
      });

      document.getElementById('configModal').classList.add('active');
    }

    function saveConfiguration() {
      UNITS_DATA.forEach(unit => {
        const fBox = document.getElementById(`focus_${unit.id}`);
        const sBox = document.getElementById(`skip_${unit.id}`);
        if(fBox && fBox.checked) focusModes[unit.id] = true; else delete focusModes[unit.id];
        if(sBox && sBox.checked) skippedModes[unit.id] = true; else delete skippedModes[unit.id];
      });

      localStorage.setItem('mathlingo_focus', JSON.stringify(focusModes));
      localStorage.setItem('mathlingo_skipped', JSON.stringify(skippedModes));
      closeModal('configModal');
      renderLearningPath();
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
    }

    function startLesson(unitId, lessonNum, nodeEl) {
      if(nodeEl && nodeEl.classList.contains('locked')) {
        alert(currentLang === 'EN' ? 'Complete previous lessons first!' : 'Hãy hoàn thành các bài học trước đó!');
        return;
      }

      activeLesson = { unitId, lessonNum };
      lessonStep = 1;

      const unitObj = UNITS_DATA.find(u => u.id === unitId);
      document.getElementById('lessonTitle').innerText = `Unit ${unitId} - ${lessonNum === 5 ? 'Checkpoint Test (Bài 5)' : `Bài học ${lessonNum}`}`;
      document.getElementById('lessonSubTitle').innerText = currentLang === 'EN' ? unitObj.titleEn : unitObj.titleVi;

      if(lessonNum < 5) {
        let startIdx = (lessonNum - 1) * 5;
        lessonDataCache = unitObj.words.slice(startIdx, startIdx + 5);
      } else {
        lessonDataCache = unitObj.words;
      }

      renderLessonStep();
      document.getElementById('lessonModal').classList.add('active');
    }

    function renderLessonStep() {
      const body = document.getElementById('lessonBody');
      const actionBtn = document.getElementById('lessonActionBtn');
      const indicator = document.getElementById('lessonStepIndicator');
      body.innerHTML = '';

      if(activeLesson.lessonNum < 5) {
        if(lessonStep <= lessonDataCache.length) {
          indicator.innerText = `Từ vựng ${lessonStep}/${lessonDataCache.length}`;
          let word = lessonDataCache[lessonStep - 1];
          actionBtn.innerText = currentLang === 'EN' ? 'Continue' : 'Tiếp tục';
          
          body.innerHTML = `
            <div style="text-align:center; margin-bottom:10px; color:var(--text-muted); font-size:0.9rem;">Chạm thẻ để lật xem nghĩa & công thức</div>
            <div class="flashcard-wrapper" onclick="this.classList.toggle('flipped')">
              <div class="flashcard-inner">
                <div class="flashcard-front">
                  <div class="card-term">${word.term}</div>
                  <div class="card-phonetic">${word.phonetic}</div>
                  <div style="font-size:0.85rem; color:var(--secondary);"><i class="fa-solid fa-rotate"></i> Lật thẻ</div>
                </div>
                <div class="flashcard-back">
                  <div class="card-meaning">${word.meaning}</div>
                  <div class="card-formula">${word.formula}</div>
                </div>
              </div>
            </div>
          `;
        } else {
          indicator.innerText = currentLang === 'EN' ? 'Practice Quiz' : 'Bài tập luyện tập';
          actionBtn.innerText = currentLang === 'EN' ? 'Check Answer' : 'Kiểm tra';
          
          let targetWord = lessonDataCache[0];
          let randomWrongs = UNITS_DATA[activeLesson.unitId-1].words.filter(w => w.term !== targetWord.term).sort(() => 0.5 - Math.random()).slice(0, 2);
          let options = [targetWord, ...randomWrongs].sort(() => 0.5 - Math.random());

          body.innerHTML = `
            <div class="cloze-sentence">
              Chọn nghĩa tiếng Việt chính xác của thuật ngữ: <span class="cloze-blank">${targetWord.term}</span> (${targetWord.formula})
            </div>
            <div class="options-grid" id="quizOptions">
              ${options.map(opt => `
                <button class="option-btn" onclick="selectOption(this, ${opt.term === targetWord.term})">
                  <span>${opt.meaning}</span>
                  <i class="fa-regular fa-circle"></i>
                </button>
              `).join('')}
            </div>
          `;
        }
      } else {
        indicator.innerText = `Bài kiểm tra Unit ${activeLesson.unitId}`;
        actionBtn.innerText = currentLang === 'EN' ? 'Submit Exam' : 'Nộp bài';

        let testWord = lessonDataCache[Math.floor(Math.random() * lessonDataCache.length)];
        let wrongs = UNITS_DATA[activeLesson.unitId-1].words.filter(w => w.term !== testWord.term).sort(() => 0.5 - Math.random()).slice(0, 3);
        let opts = [testWord, ...wrongs].sort(() => 0.5 - Math.random());

        body.innerHTML = `
          <div style="background:var(--card-bg); padding:14px; border-radius:12px; margin-bottom:14px; border:2px solid var(--card-border);">
            <strong><i class="fa-solid fa-triangle-exclamation" style="color:var(--gold);"></i> Kiểm tra năng lực Unit ${activeLesson.unitId}</strong>
            <p style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">Yêu cầu đạt chuẩn để mở khóa Unit tiếp theo.</p>
          </div>
          <div class="cloze-sentence">
            Thuật ngữ toán học nào tương ứng với ý nghĩa: <b>"${testWord.meaning}"</b> (Ký hiệu: <code>${testWord.formula}</code>)?
          </div>
          <div class="options-grid" id="quizOptions">
            ${opts.map(o => `
              <button class="option-btn" onclick="selectOption(this, ${o.term === testWord.term})">
                <span>${o.term} <i>(${o.phonetic})</i></span>
                <i class="fa-regular fa-circle"></i>
              </button>
            `).join('')}
          </div>
        `;
      }
    }

    function selectOption(btnEl, isCorrect) {
      document.querySelectorAll('.options-grid .option-btn').forEach(b => {
        b.classList.remove('selected');
        b.querySelector('i').className = 'fa-regular fa-circle';
      });
      btnEl.classList.add('selected');
      btnEl.querySelector('i').className = 'fa-solid fa-circle-check';
      window.selectedAnswerCorrect = isCorrect;
    }

    function handleLessonNext() {
      if(activeLesson.lessonNum < 5 && lessonStep <= lessonDataCache.length) {
        lessonStep++;
        renderLessonStep();
        return;
      }

      if(window.selectedAnswerCorrect === false) {
        showFeedbackSheet(false, "Thuật ngữ này chưa chính xác. Hãy chú ý ghi nhớ công thức và định nghĩa chuẩn trong SGK Toán 9!");
        window.selectedAnswerCorrect = undefined;
        return;
      }

      userXP += 25;
      completedLessons[`${activeLesson.unitId}-${activeLesson.lessonNum}`] = true;
      localStorage.setItem('mathlingo_completed', JSON.stringify(completedLessons));
      updateHeaderStats();

      closeModal('lessonModal');
      renderLearningPath();
      showFeedbackSheet(true, "Chúc mừng! Bạn đã hoàn thành bài học xuất sắc và nhận +25 XP!");
    }

    function showFeedbackSheet(isCorrect, msg) {
      const sheet = document.getElementById('feedbackSheet');
      const title = document.getElementById('fbTitle');
      const desc = document.getElementById('fbDesc');

      if(isCorrect) {
        sheet.className = 'feedback-sheet correct-sheet active';
        title.innerHTML = '<i class="fa-solid fa-circle-check"></i><span>Tuyệt vời!</span>';
      } else {
        sheet.className = 'feedback-sheet active';
        title.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i><span>Chưa chính xác!</span>';
      }
      desc.innerText = msg;
    }

    function closeFeedbackSheet() {
      document.getElementById('feedbackSheet').classList.remove('active');
    }
  </script>
</body>
</html>